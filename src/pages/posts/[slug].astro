---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <a href="/" class="font-mono text-[13px] text-muted transition-colors hover:text-accent">← index</a>

  <header class="mt-12 mb-10 border-b border-line pb-8">
    <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
      <time class="tabular-nums" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {post.data.draft && <span class="text-accent"> · draft</span>}
    </p>
    <h1 class="mt-3 text-[30px] font-semibold leading-[1.2] tracking-[-0.02em]">{post.data.title}</h1>
  </header>

  <article class="prose prose-matte max-w-none text-[16px] leading-[1.75]">
    <Content />
  </article>
</Base>
